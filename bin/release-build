#!/usr/bin/env bash
# Signed release build of Leader Key: build/release/Leader-Key-<version>.zip.
#
# Signs with the fork's self-signed certificate from a temporary keychain that
# exists only for this run, verifies the app and every embedded Sparkle
# component, and checks the app's designated requirement against the pinned
# signing/designated-requirement.txt, so macOS sees every release as the same
# app and its permissions survive updates. Used by .github/workflows/release.yml
# and for smoke tests on mba13.
#
# Environment:
#   SIGNING_P12           path to the .p12 holding the certificate and key (required)
#   SIGNING_P12_PASSWORD  its password (required)
#   MARKETING_VERSION     x.y.z; default: the project's
#   BUILD_NUMBER          CFBundleVersion; default: git rev-list --count HEAD
#   DEVELOPER_DIR         honoured; default: /Applications/Xcode.app
set -euo pipefail

cd "$(dirname "$0")/.."

export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"

identity_sha1="4159da3fbef7479b9337643e05a13a6258830b92"
requirement_file="signing/designated-requirement.txt"
derived_data="build/DerivedData-release"
output_dir="build/release"

log() { echo "release-build: $*" >&2; }
fail() {
  log "$*"
  exit 1
}

[[ -n "${SIGNING_P12:-}" ]] || fail "SIGNING_P12 is not set"
[[ -n "${SIGNING_P12_PASSWORD:-}" ]] || fail "SIGNING_P12_PASSWORD is not set"
[[ -r "$SIGNING_P12" ]] || fail "cannot read SIGNING_P12 at $SIGNING_P12"
[[ -f "$requirement_file" ]] || fail "missing $requirement_file"
if [[ -n "${MARKETING_VERSION:-}" && ! "$MARKETING_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  fail "MARKETING_VERSION must be x.y.z, got '$MARKETING_VERSION'"
fi
if [[ -z "${BUILD_NUMBER:-}" ]]; then
  BUILD_NUMBER="$(git rev-list --count HEAD)" || fail "BUILD_NUMBER is not set and git rev-list failed"
fi

# --- Temporary keychain, removed on every exit path ---------------------------

# xcodebuild splits OTHER_CODE_SIGN_FLAGS on whitespace, so the keychain path must have none.
tmp_root="${TMPDIR:-/tmp}"
[[ "$tmp_root" == *" "* ]] && tmp_root=/tmp
work="$(mktemp -d "$tmp_root/leaderkey-release.XXXXXX")"
chmod 700 "$work"
keychain="$work/signing.keychain-db"
keychain_password="$(openssl rand -hex 32)"
cert="$work/cert.pem"
# The user search list as it was, one path per line, so the trap can restore it.
original_keychains=()
while IFS= read -r line; do
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line#\"}"
  line="${line%\"}"
  [[ -n "$line" ]] && original_keychains+=("$line")
done <<<"$(security list-keychains -d user)"
search_list_changed=0
trusted_in=""

cleanup() {
  local status=$?
  set +e
  case "$trusted_in" in
    user) security remove-trusted-cert "$cert" >/dev/null 2>&1 ;;
    admin) sudo -n security remove-trusted-cert -d "$cert" >/dev/null 2>&1 ;;
  esac
  if ((search_list_changed)) && ((${#original_keychains[@]})); then
    security list-keychains -d user -s "${original_keychains[@]}"
  fi
  [[ -f "$keychain" ]] && security delete-keychain "$keychain"
  rm -rf "$work"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

security create-keychain -p "$keychain_password" "$keychain"
security set-keychain-settings -u -t 21600 "$keychain"
security unlock-keychain -p "$keychain_password" "$keychain"
security import "$SIGNING_P12" -k "$keychain" -P "$SIGNING_P12_PASSWORD" -f pkcs12 \
  -T /usr/bin/codesign -T /usr/bin/security >/dev/null
security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$keychain_password" \
  "$keychain" >/dev/null
security list-keychains -d user -s "$keychain" "${original_keychains[@]}"
search_list_changed=1

security find-identity -p codesigning "$keychain" | grep -qi "$identity_sha1" \
  || fail "the .p12 does not hold identity $identity_sha1"

# --- Trust fallback -----------------------------------------------------------
# codesign takes the untrusted self-signed identity by hash on current macOS. If
# it ever refuses (CSSMERR_TP_NOT_TRUSTED), trust the certificate for code
# signing for the rest of this run; the trap removes that again.

probe="$work/probe"
cp /usr/bin/true "$probe"
if ! codesign --force --sign "$identity_sha1" --keychain "$keychain" "$probe" 2>"$work/probe.err"; then
  log "codesign refused the identity ($(tr -d '\n' <"$work/probe.err")); trusting it for this run"
  security export -k "$keychain" -t certs -f pemseq -o "$cert" >/dev/null 2>&1
  if security add-trusted-cert -r trustRoot -p codeSign "$cert" 2>/dev/null; then
    trusted_in=user
  elif sudo -n security add-trusted-cert -d -r trustRoot -p codeSign "$cert" 2>/dev/null; then
    trusted_in=admin
  else
    fail "could not add trust settings; needs a GUI session or passwordless sudo"
  fi
  codesign --force --sign "$identity_sha1" --keychain "$keychain" "$probe" \
    || fail "codesign still refuses the identity after trusting it"
fi

# --- Build --------------------------------------------------------------------

log "building $(git rev-parse --short HEAD 2>/dev/null || echo "(no git)")" \
  "build $BUILD_NUMBER${MARKETING_VERSION:+ version $MARKETING_VERSION}"
xcodebuild build \
  -project "Leader Key.xcodeproj" \
  -scheme "Leader Key" \
  -configuration Release \
  -destination "generic/platform=macOS" \
  -derivedDataPath "$derived_data" \
  -skipPackagePluginValidation \
  -skipMacroValidation \
  -quiet \
  CODE_SIGN_IDENTITY="$identity_sha1" \
  CODE_SIGN_STYLE=Manual \
  DEVELOPMENT_TEAM= \
  OTHER_CODE_SIGN_FLAGS="--keychain $keychain" \
  CURRENT_PROJECT_VERSION="$BUILD_NUMBER" \
  ${MARKETING_VERSION:+MARKETING_VERSION="$MARKETING_VERSION"}

app="$derived_data/Build/Products/Release/Leader Key.app"
[[ -d "$app" ]] || fail "no app at $app"
sparkle="$app/Contents/Frameworks/Sparkle.framework"
[[ -d "$sparkle" ]] || fail "Sparkle.framework is not embedded in the app"

# --- Sign Sparkle's helpers -----------------------------------------------------
# Xcode's sign-on-copy signs the framework itself, but the helpers inside it
# arrive ad-hoc signed from the Sparkle package and Xcode leaves them that way.
# Sign each helper with the same identity, then re-seal the framework and the
# app so their resource seals cover the new signatures. One component per call;
# never --deep, which would sign whatever it happens to find.

resign() {
  if ! codesign --force --sign "$identity_sha1" --keychain "$keychain" --timestamp=none \
    --preserve-metadata=identifier,entitlements,flags "$1" 2>"$work/codesign.err"; then
    cat "$work/codesign.err" >&2
    fail "could not sign ${1#"$app/"}"
  fi
}

helpers=()
while IFS= read -r -d '' helper; do
  helpers+=("$helper")
done < <(find "$sparkle/Versions/B" -maxdepth 2 -not -type l \
  \( -name '*.xpc' -o -name '*.app' -o -name Autoupdate \) -print0 | sort -z)
((${#helpers[@]} == 4)) \
  || fail "expected Sparkle's four helpers (two XPC services, Autoupdate, Updater.app), found ${#helpers[@]}"
for helper in "${helpers[@]}"; do
  resign "$helper"
done
resign "$sparkle/Versions/B"
resign "$app"

# --- Verify every signature -----------------------------------------------------

# Leaf certificate SHA-1 of a signed component's signature.
signer_of() {
  rm -f "$work"/signer-*
  codesign -d --extract-certificates="$work/signer-" "$1" 2>/dev/null
  [[ -f "$work/signer-0" ]] || return 1
  openssl x509 -inform der -in "$work/signer-0" -noout -fingerprint -sha1 \
    | sed -e 's/.*=//' -e 's/://g' | tr '[:upper:]' '[:lower:]'
}

components=("$app" "$sparkle" "${helpers[@]}")
for component in "${components[@]}"; do
  codesign --verify --strict --verbose=1 "$component" \
    || fail "signature check failed: ${component#"$app/"}"
  signer="$(signer_of "$component")" \
    || fail "no certificate in the signature of ${component#"$app/"}"
  [[ "$signer" == "$identity_sha1" ]] \
    || fail "${component#"$app/"} is signed by $signer, expected $identity_sha1"
done
log "verified ${#components[@]} signatures by $identity_sha1"

codesign -d -r- "$app" 2>/dev/null >"$work/requirement.txt"
diff -u "$requirement_file" "$work/requirement.txt" >&2 \
  || fail "designated requirement differs from $requirement_file"

# --- Package ------------------------------------------------------------------

version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist")"
mkdir -p "$output_dir"
zip="$output_dir/Leader-Key-$version.zip"
rm -f "$zip"
ditto -c -k --sequesterRsrc --keepParent "$app" "$zip"

# The archive is what Sparkle installs, so it must unpack to a valid signature.
ditto -x -k "$zip" "$work/unpacked"
codesign --verify --strict "$work/unpacked/Leader Key.app" \
  || fail "the zipped app does not verify after extraction"

echo "$PWD/$zip"
